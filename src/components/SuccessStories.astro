---
// Karussell mit illustrativen Anwendungsbeispielen (kein Kunden-Feedback -
// Skill-Lens ist in der Pilotphase). Bewusst als Vorher/Nachher-Szenario und
// nicht als zitiertes Testimonial mit Name/Sternebewertung formuliert, damit
// nichts als echte Kundenstimme missverstanden werden kann.
import Icon from './Icon.astro';

interface Story {
  emoji: string;
  context: string;
  task: string;
  before: string;
  after: string;
}

const stories: Story[] = [
  {
    emoji: '🧼',
    context: 'Zuhause, mit der Familie',
    task: 'Hände waschen',
    before: 'Brauchte bei jedem einzelnen Schritt eine Erinnerung.',
    after: 'Wäscht sich die Hände inzwischen allein — Schritt für Schritt von der App begleitet.',
  },
  {
    emoji: '🍽️',
    context: 'In der Wohngruppe',
    task: 'Tisch decken',
    before: 'Wusste oft nicht, wo Teller und Besteck hingehören.',
    after: 'Deckt den Tisch inzwischen selbstständig, bevor alle gemeinsam essen.',
  },
  {
    emoji: '☕',
    context: 'Zuhause, mit der Familie',
    task: 'Kaffee machen',
    before: 'Traute sich nicht an die Kaffeemaschine heran.',
    after: 'Macht mittlerweile jeden Morgen selbst einen Kaffee — mit sichtbarem Stolz.',
  },
  {
    emoji: '🧺',
    context: 'In der Werkstatt',
    task: 'Eigene Aufgabe: Wäsche sortieren',
    before: 'Musste bei jedem Sortierschritt begleitet werden.',
    after: 'Sortiert die Wäsche jetzt im eigenen Tempo — als selbst angelegte Aufgabe mit Referenzfoto.',
  },
  {
    emoji: '🗓️',
    context: 'In der Wohngruppe',
    task: 'Morgenroutine',
    before: 'Brauchte am Morgen volle Unterstützung, um überhaupt loszulegen.',
    after: 'Geht die Morgenroutine inzwischen eigenständig durch — die App erinnert sanft zur richtigen Zeit.',
  },
];
---

<section id="stories" class="sl-stories card reveal" aria-labelledby="sl-stories-heading">
  <div class="sl-stories-head">
    <h2 id="sl-stories-heading" class="sl-stories-title">So könnte der Alltag mit Skill-Lens aussehen</h2>
    <p class="sl-stories-caption">Beispielhafte Anwendungsfälle, keine echten Kundenstimmen — Skill-Lens startet gerade in die Pilotphase.</p>
  </div>

  <div class="sl-stories-viewport">
    <p id="stories-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

    <button type="button" class="sl-stories-nav sl-stories-prev" data-dir="-1" aria-label="Vorheriges Beispiel">
      <Icon name="arrow" class="h-5 w-5 sl-stories-nav-icon-prev" />
    </button>

    <div class="sl-stories-clip">
    <ul class="sl-stories-track" style={`--sl-count: ${stories.length}`}>
      {stories.map((s, i) => (
        <li class="sl-stories-slide" data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <article class="sl-stories-card">
            <span class="sl-stories-emoji" aria-hidden="true">{s.emoji}</span>
            <p class="sl-stories-context">{s.context}</p>
            <h3 class="sl-stories-task">{s.task}</h3>
            <div class="sl-stories-row sl-stories-before">
              <span class="sl-stories-tag">Vorher</span>
              <p>{s.before}</p>
            </div>
            <div class="sl-stories-row sl-stories-after">
              <span class="sl-stories-tag sl-stories-tag--after"><Icon name="check" class="h-4 w-4" /> Nachher</span>
              <p>{s.after}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
    </div>

    <button type="button" class="sl-stories-nav sl-stories-next" data-dir="1" aria-label="Nächstes Beispiel">
      <Icon name="arrow" class="h-5 w-5" />
    </button>
  </div>

  <div class="sl-stories-dots" role="tablist" aria-label="Beispiel auswählen">
    {stories.map((s, i) => (
      <button
        type="button"
        class="sl-stories-dot"
        data-dot={i}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Beispiel ${i + 1} von ${stories.length}: ${s.task}`}
      />
    ))}
  </div>
</section>

<script>
  (function () {
    const root = document.getElementById('stories');
    if (!root) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const track = root.querySelector<HTMLElement>('.sl-stories-track');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.sl-stories-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.sl-stories-dot'));
    const navButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.sl-stories-nav'));
    const status = document.getElementById('stories-status');
    const count = slides.length;
    if (!track || count === 0) return;

    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const AUTOPLAY_MS = 6000;

    function render() {
      track!.style.transform = `translateX(-${index * (100 / count)}%)`;
      slides.forEach((s, i) => s.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
      dots.forEach((d, i) => {
        d.setAttribute('aria-selected', i === index ? 'true' : 'false');
        d.classList.toggle('is-active', i === index);
      });
      const task = slides[index]?.querySelector('.sl-stories-task')?.textContent ?? '';
      if (status) status.textContent = `Beispiel ${index + 1} von ${count}: ${task}`;
    }

    function goTo(i: number) {
      index = ((i % count) + count) % count;
      render();
    }

    function startAutoplay() {
      if (reduceMotion || timer !== null) return;
      timer = setInterval(() => goTo(index + 1), AUTOPLAY_MS);
    }
    function stopAutoplay() {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }

    navButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.dir ?? '1');
        goTo(index + dir);
        stopAutoplay();
        startAutoplay();
      });
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(Number(dot.dataset.dot ?? '0'));
        stopAutoplay();
        startAutoplay();
      });
    });

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    render();
    startAutoplay();
  })();
</script>

<style>
  .sl-stories { padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .sl-stories-head { max-width: 40rem; margin: 0 auto; text-align: center; }
  .sl-stories-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--color-ink);
  }
  .sl-stories-caption { margin-top: 0.5rem; font-size: 0.85rem; color: var(--color-muted); font-style: italic; }

  .sl-stories-viewport {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 34rem;
    margin: 0 auto;
    width: 100%;
  }

  .sl-stories-clip {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .sl-stories-track {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    width: calc(var(--sl-count, 1) * 100%);
    transition: transform 0.5s cubic-bezier(.22,1,.36,1);
  }
  @media (prefers-reduced-motion: reduce) {
    .sl-stories-track { transition: none; }
  }

  .sl-stories-slide {
    flex: 0 0 auto;
    width: calc(100% / var(--sl-count, 1));
    box-sizing: border-box;
    padding: 0 0.25rem;
  }

  .sl-stories-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-radius: 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
    padding: 1.5rem;
    min-height: 15rem;
  }
  .sl-stories-emoji { font-size: 2rem; line-height: 1; }
  .sl-stories-context { font-size: 0.8rem; font-weight: 700; color: var(--color-brand-600); text-transform: uppercase; letter-spacing: 0.02em; }
  .sl-stories-task { font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; color: var(--color-ink); margin: 0; }

  .sl-stories-row { display: flex; flex-direction: column; gap: 0.25rem; }
  .sl-stories-row p { margin: 0; color: var(--color-muted); font-size: 0.95rem; }
  .sl-stories-tag {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .sl-stories-tag--after {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-grass);
  }
  .sl-stories-after p { color: var(--color-ink); font-weight: 600; }

  .sl-stories-nav {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-brand-600);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    transition: transform 0.15s var(--ease), box-shadow 0.2s var(--ease);
  }
  .sl-stories-nav:hover, .sl-stories-nav:focus-visible {
    box-shadow: var(--shadow-lift);
    transform: translateY(-1px);
  }
  .sl-stories-nav-icon-prev { transform: rotate(180deg); }

  .sl-stories-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }
  .sl-stories-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-line-strong);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .sl-stories-dot.is-active {
    background: var(--color-brand);
    transform: scale(1.3);
  }
</style>
