---
interface Props { word?: boolean; class?: string; big?: boolean }
const { word = true, class: cls = '', big = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <span class:list={['sl-mark', big && 'sl-mark-big']} aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="10" cy="10" r="6.6"></circle>
      <path d="M15 15l5.4 5.4"></path>
      <path d="M6.8 10.2l2.2 2.2 4.1-4.6"></path>
    </svg>
  </span>
  {
    word && (
      <span class:list={['font-display font-bold leading-none text-ink', big ? 'text-3xl' : 'text-[1.3rem]']}>
        Skill<span class="text-brand-600">-</span>Lens
      </span>
    )
  }
</span>

<style>
  .sl-mark {
    display: grid; place-items: center;
    width: 2.4rem; height: 2.4rem; border-radius: 0.7rem;
    background: linear-gradient(150deg, #6e8bff, #3d5ae0);
    box-shadow: var(--shadow-soft);
  }
  .sl-mark svg { width: 1.5rem; height: 1.5rem; }
  .sl-mark-big { width: 3.4rem; height: 3.4rem; border-radius: 1rem; }
  .sl-mark-big svg { width: 2.1rem; height: 2.1rem; }
</style>
