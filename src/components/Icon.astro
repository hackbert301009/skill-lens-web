  arrow: { body: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  mail: { body: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M4 7l8 5.5L20 7"/>' },
  phone: { body: '<path d="M6.6 3.5c.5 0 1 .3 1.1.8l1.1 2.7a1.2 1.2 0 0 1-.3 1.3L7.3 9.5a11.5 11.5 0 0 0 5.2 5.2l1.2-1.3a1.2 1.2 0 0 1 1.3-.3l2.7 1.1c.5.2.8.6.8 1.1v2.1a2.3 2.3 0 0 1-2.5 2.3A15.8 15.8 0 0 1 3.4 6a2.3 2.3 0 0 1 2.3-2.5z"/>' },
