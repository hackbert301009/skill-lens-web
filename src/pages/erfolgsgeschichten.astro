---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SuccessStories from '../components/SuccessStories.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Beispiele & Erfolge · Skill-Lens"
  description="Beispielhafte Anwendungsfälle: Wie Skill-Lens im Alltag helfen kann, Schritt für Schritt Selbstständigkeit aufzubauen."
>
  <PageHeader
    eyebrow="Beispiele aus dem Alltag"
    icon="star"
    title="Was Skill-Lens im Alltag verändern kann"
    lead="Ein paar beispielhafte Situationen, wie Skill-Lens Schritt für Schritt beim Selbstständig-Werden helfen kann — zuhause, in der Wohngruppe oder in der Werkstatt."
  />

  <section class="mx-auto max-w-3xl px-5 pb-16">
    <SuccessStories />
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-5 pb-20">
    <div class="reveal rounded-[2rem] bg-brand px-6 py-14 text-center text-white">
      <h2 class="text-3xl text-white sm:text-4xl">Neugierig, wie es bei euch aussehen könnte?</h2>
      <p class="mx-auto mt-4 max-w-xl text-xl text-white/90">
        Skill-Lens läuft offline, ohne Cloud und ohne Konto. Lad die App herunter und probier es mit einer ersten Aufgabe aus.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/download" class="btn bg-white text-brand-600 hover:bg-white/90">App holen <Icon name="arrow" class="h-5 w-5" /></a>
        <a href="/funktionen" class="btn border-2 border-white/60 bg-transparent text-white hover:bg-white/10">Alle Funktionen ansehen</a>
      </div>
    </div>
  </section>
</Base>
