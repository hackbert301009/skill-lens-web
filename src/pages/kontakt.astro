---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

const channels = [
  { icon: 'mail', label: 'E-Mail', handle: 'Heruth@eyespec-faw.de', href: 'mailto:Heruth@eyespec-faw.de', ext: false },
  { icon: 'phone', label: 'Telefon', handle: '015204277531', href: 'tel:+4915204277531', ext: false },
  { icon: 'lens', label: 'Webseite', handle: 'hackbert.org', href: 'https://hackbert.org', ext: true },
];
---

<Base title="Kontakt · Skill-Lens ausprobieren">
  <PageHeader
    eyebrow="Sag Hallo"
    icon="mail"
    title="Kontakt aufnehmen"
    lead="Ob Familie, Werkstatt oder Wohngruppe: Schreib uns, was du brauchst. Wir melden uns bei dir."
  />

  <section class="pb-24">
    <div class="mx-auto grid max-w-5xl gap-10 px-5 lg:grid-cols-[1.3fr_0.9fr]">
      <!-- AJAX FORM -->
      <form id="contact-form" action="https://formspree.io/f/xeolbyyz" method="POST" class="reveal card p-7 sm:p-8">
        <input type="hidden" name="_subject" value="Neue Nachricht über die Skill-Lens Webseite" />
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="mb-2 block font-semibold text-ink">Dein Name</span>
            <input type="text" name="name" required autocomplete="name"
              class="w-full rounded-2xl border-2 border-line bg-paper px-4 py-3 text-lg text-ink outline-none transition focus:border-brand" />
          </label>
          <label class="block">
            <span class="mb-2 block font-semibold text-ink">Deine E-Mail</span>
            <input type="email" name="email" required autocomplete="email"
              class="w-full rounded-2xl border-2 border-line bg-paper px-4 py-3 text-lg text-ink outline-none transition focus:border-brand" />
          </label>
        </div>

        <label class="mt-5 block">
          <span class="mb-2 block font-semibold text-ink">Ich schreibe als</span>
          <select name="rolle"
            class="w-full rounded-2xl border-2 border-line bg-paper px-4 py-3 text-lg text-ink outline-none transition focus:border-brand">
            <option>Angehörige oder Angehöriger</option>
            <option>Betreuungskraft</option>
            <option>Einrichtung oder Werkstatt</option>
            <option>Ich möchte mitmachen</option>
            <option>Sonstiges</option>
          </select>
        </label>

        <label class="mt-5 block">
          <span class="mb-2 block font-semibold text-ink">Deine Nachricht</span>
          <textarea name="message" required rows="6"
            class="w-full rounded-2xl border-2 border-line bg-paper px-4 py-3 text-lg text-ink outline-none transition focus:border-brand"></textarea>
        </label>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button type="submit" id="submit-btn" class="btn btn-primary">
            Nachricht senden <Icon name="arrow" class="h-5 w-5" />
          </button>
          <p id="form-status" class="text-lg font-semibold" role="status" aria-live="polite"></p>
        </div>
        <p class="mt-4 text-base text-muted">
          Mit dem Absenden bist du einverstanden, dass wir deine Angaben zur Beantwortung nutzen. Mehr in der
          <a href="/datenschutz" class="font-semibold text-brand-600">Datenschutzerklärung</a>.
        </p>
      </form>

      <!-- CHANNELS -->
      <aside class="reveal">
        <p class="mb-5 font-semibold text-muted">Oder direkt</p>
        <div class="flex flex-col gap-3">
          {channels.map((c) => (
            <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'me noopener noreferrer' : undefined}
              class="card flex items-center gap-4 p-4 transition hover:border-brand">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-soft text-brand-600"><Icon name={c.icon as any} class="h-6 w-6" /></span>
              <span>
                <span class="block font-display text-lg font-bold text-ink">{c.label}</span>
                <span class="text-base text-muted">{c.handle}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="mt-6 rounded-2xl border border-line bg-grass-soft p-5 text-lg text-ink">
          <span class="inline-flex items-center gap-2 font-semibold text-grass"><Icon name="heart" class="h-5 w-5" /> Ein Herzensprojekt</span>
          <p class="mt-1 text-base text-muted">Wir antworten persönlich, kein Vertrieb, kein Newsletter.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script is:inline>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const btn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;
    btn.disabled = true;
    status.textContent = 'Wird gesendet ...';
    status.style.color = 'var(--color-muted)';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        status.textContent = 'Danke! Deine Nachricht ist angekommen.';
        status.style.color = 'var(--color-grass)';
      } else {
        const data = await res.json().catch(() => ({}));
        status.textContent = data?.errors?.[0]?.message || 'Etwas ist schiefgelaufen. Bitte per E-Mail melden.';
        status.style.color = 'var(--color-coral-ink)';
      }
    } catch {
      status.textContent = 'Etwas ist schiefgelaufen. Bitte per E-Mail melden.';
      status.style.color = 'var(--color-coral-ink)';
    } finally {
      btn.disabled = false;
    }
  });
</script>
