---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import Icon from '../components/Icon.astro';
import { detectFlow, features, tasks } from '../data/site.ts';
import shotHelp from '../assets/shots/shot-help.png';
import shotPeople from '../assets/shots/shot-people.png';
import shotReports from '../assets/shots/shot-reports.png';

const toneRing: Record<string, string> = {
  brand: 'border-brand text-brand-600 bg-brand-soft',
  grass: 'border-grass/40 text-grass bg-grass-soft',
  sun: 'border-sun/50 text-[#8a5300] bg-[#fdf0d6]',
};
const shots = [
  { src: shotHelp, alt: 'Hilfe-Bildschirm von Skill-Lens mit einem erkannten Gegenstand und einem ruhigen Hinweis.', title: 'Ruhige Hinweise', text: 'Statt Fehlermeldungen gibt es sanfte Hilfe, wenn ein Schritt noch nicht klappt.' },
  { src: shotPeople, alt: 'Bildschirm mit mehreren Personen-Profilen auf einem Gerät.', title: 'Mehrere Personen', text: 'Jede Person hat ein eigenes Profil mit eigenem Fortschritt und eigenen Stickern.' },
  { src: shotReports, alt: 'Berichts-Bildschirm mit Auswertung des Fortschritts für Betreuende.', title: 'Berichte für Betreuende', text: 'Fortschritt als PDF für Eltern, Einrichtung und Kostenträger.' },
];
---

<Base title="So funktioniert Skill-Lens · Erkennen. Begleiten. Bestätigen.">
  <PageHeader
    eyebrow="Erkennen. Begleiten. Bestätigen."
    icon="lens"
    title="So funktioniert Skill-Lens"
    lead="Die Kamera schaut mit und bestätigt jeden Schritt im echten Moment. Ruhig, in Leichter Sprache, ohne Druck."
  />

  <!-- DETECTION FLOW -->
  <section class="mx-auto max-w-6xl px-5 py-12">
    <ol class="grid gap-6 md:grid-cols-3">
      {detectFlow.map((s, i) => (
        <li class="card reveal p-7">
          <span class={`inline-flex items-center gap-2 rounded-full border-2 px-3 py-1 font-display text-sm font-bold ${toneRing[s.tone]}`}>Schritt {i + 1}</span>
          <span class:list={['mt-5 grid h-14 w-14 place-items-center rounded-2xl', toneRing[s.tone]]}><Icon name={s.icon} class="h-7 w-7" /></span>
          <h2 class="mt-4 text-xl">{s.title}</h2>
          <p class="mt-2 text-lg text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ALL FEATURES -->
  <section class="border-y border-line bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="reveal mb-12 max-w-2xl">
        <p class="eyebrow mb-3"><Icon name="steps" class="h-5 w-5" /> Alle Funktionen</p>
        <h2 class="text-3xl sm:text-4xl">Alles für ruhiges, selbstständiges Üben</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <article class="reveal rounded-2xl border border-line bg-paper p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-soft text-brand-600"><Icon name={f.icon} class="h-6 w-6" /></span>
            <h3 class="mt-4 text-xl">{f.title}</h3>
            <p class="mt-2 text-lg text-muted">{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SCREENSHOTS -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="reveal mb-12 max-w-2xl">
      <p class="eyebrow mb-3"><Icon name="camera" class="h-5 w-5" /> So sieht die App aus</p>
      <h2 class="text-3xl sm:text-4xl">Groß, klar und ruhig</h2>
    </div>
    <div class="grid gap-10 md:grid-cols-3">
      {shots.map((s) => (
        <figure class="reveal text-center">
          <PhoneFrame src={s.src} alt={s.alt} class="mx-auto" />
          <figcaption class="mt-5">
            <span class="block font-display text-xl font-bold">{s.title}</span>
            <span class="mt-1 block text-lg text-muted">{s.text}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- HONEST OFFLINE NOTE -->
  <section class="mx-auto max-w-4xl px-5 pb-8">
    <div class="reveal rounded-2xl border border-line bg-brand-soft p-7">
      <p class="eyebrow mb-2"><Icon name="offline" class="h-5 w-5" /> Ehrlich gesagt</p>
      <h2 class="text-2xl">Offline, mit einer Ausnahme</h2>
      <p class="mt-3 text-lg text-muted">
        Beim ersten Start lädt die App einmalig ihre Erkennungs-Modelle aus dem Internet. Danach arbeitet Skill-Lens
        ohne Internet weiter. Fotos, Namen oder Inhalte werden dabei nie übertragen. Mehr dazu in der
        <a href="/datenschutz" class="font-semibold text-brand-600">Datenschutzerklärung</a>.
      </p>
    </div>
  </section>
</Base>
