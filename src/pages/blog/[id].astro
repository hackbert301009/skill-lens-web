---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${post.data.title} · Skill-Lens Blog`} description={post.data.summary}>
  <PageHeader
    eyebrow={post.data.version ? `Version ${post.data.version}` : 'Blog'}
    icon="report"
    title={post.data.title}
    lead={post.data.summary}
  />

  <section class="mx-auto max-w-3xl px-5 pb-24">
    <p class="reveal mb-8 text-base font-semibold text-muted">
      <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
    </p>
    <div class="prose reveal">
      <Content />
    </div>

    <div class="reveal mt-12 flex flex-wrap gap-3">
      <a href="/blog" class="btn btn-secondary"><Icon name="arrow" class="h-5 w-5 rotate-180" /> Alle Einträge</a>
      <a href="/download" class="btn btn-primary">App holen <Icon name="arrow" class="h-5 w-5" /></a>
    </div>
  </section>
</Base>
